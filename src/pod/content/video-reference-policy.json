{
  "version": 3,
  "status": "REQUIRED",
  "referenceRequiredForEveryGeneration": true,
  "allowTextOnlyFallback": false,
  "captureMoment": "trigger-snapshot",
  "mimeType": "image/png",
  "providerImageField": "content[].image_url.url",
  "routes": {
    "player-capture": {
      "anchor": "player",
      "camera": "active-player-camera",
      "allowPlayerCameraFallback": false
    },
    "player-action": {
      "anchor": "player",
      "camera": "active-player-camera",
      "allowPlayerCameraFallback": false
    },
    "elias-story": {
      "anchor": "elias",
      "camera": "authored-elias-scene-camera",
      "allowPlayerCameraFallback": false,
      "taskVideoOverride": {
        "camera": "elias-selfie",
        "reference": "authored-task-image",
        "registry": "src/pod/content/elias-video-atoms.ts",
        "missingReference": "reject",
        "fallenProbe": "fixed-authored-incident"
      }
    }
  },
  "requiredSnapshotFields": [
    "triggerId",
    "sceneId",
    "epoch",
    "capturedAt",
    "videoType",
    "anchorEntityId",
    "anchorPosition",
    "cameraPosition",
    "cameraQuaternion",
    "verticalFov",
    "aspectRatio",
    "lightingState",
    "imageHash"
  ],
  "rejectWhen": [
    "unknown-video-type",
    "missing-anchor",
    "missing-authored-camera",
    "missing-image",
    "capture-failed",
    "snapshot-mismatch",
    "invalid-image",
    "provider-image-input-unsupported"
  ],
  "retryReference": "same-locked-image",
  "cacheIdentityFields": [
    "videoType",
    "triggerId",
    "sceneId",
    "epoch",
    "anchorEntityId",
    "anchorPosition",
    "cameraPosition",
    "cameraQuaternion",
    "verticalFov",
    "aspectRatio",
    "lightingState",
    "imageHash",
    "prompt",
    "duration"
  ],
  "providerImageRole": "reference_image",
  "forbiddenProviderImageFields": [
    "first_frame",
    "last_frame",
    "first_frame_image",
    "last_frame_image",
    "input_reference"
  ]
}
