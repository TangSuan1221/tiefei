  "cacheIdentityFields": ["videoType", "triggerId", "sceneId", "epoch", "anchorEntityId", "anchorPosition", "cameraPosition", "cameraQuaternion", "verticalFov", "aspectRatio", "lightingState", "imageHash", "prompt", "duration"]
