  "requiredSnapshotFields": ["triggerId", "sceneId", "epoch", "capturedAt", "videoType", "anchorEntityId", "anchorPosition", "cameraPosition", "cameraQuaternion", "verticalFov", "aspectRatio", "lightingState", "imageHash"],
